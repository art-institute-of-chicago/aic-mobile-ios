  "strings" : {
    "info_quick_action_prompt" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can quickly get back to this screen by long-pressing the app icon on the home screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede regresar rápidamente a esta pantalla manteniendo presionado el ícono de la aplicación en la pantalla de inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez rapidement revenir à cet écran en appuyant longuement sur l'icône de l'application sur l'écran d'accueil."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "홈 화면에서 앱 아이콘을 길게 누르면 이 화면으로 빠르게 돌아갈 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以通过长按主屏幕上的应用图标快速返回此屏幕。"
          }
        }
      }
    },
