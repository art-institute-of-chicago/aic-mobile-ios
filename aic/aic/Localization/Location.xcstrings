    "location_settings_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We’d like to use your location to help you navigate the museum."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nos gustaría usar su ubicación para ayudarle a navegar por el museo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous aimerions utiliser votre localisation pour vous aider à naviguer dans le musée."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신의 현재 위치를 이용하여 박물관 위치 탐색에 도움을 드릴 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们想使用您的位置帮助您找到博物馆。"
          }
        }
      }
    },
